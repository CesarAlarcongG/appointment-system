    {
      "id": "EwawNJWhFX_h6SQ8FEUhG",
      "type": "text",
      "x": -2027.8952733292108,
      "y": -7341.3345563388775,
      "width": 1095.43359375,
      "height": 568.3090974222171,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
